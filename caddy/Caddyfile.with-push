# Production Caddyfile: API + ntfy UnifiedPush, both with automatic HTTPS.
# Requires compose profiles "proxy" and "push" (COMPOSE_PROFILES=proxy,push).
#
# Set in .env:
#   SITE_ADDRESS=openfamily.example.com
#   PUSH_ADDRESS=push.example.com
#   NTFY_BASE_URL=https://push.example.com
#   CADDYFILE=Caddyfile.with-push

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), camera=(), microphone=()"
		-Server
	}
}

{$SITE_ADDRESS:localhost} {
	import security_headers
	# Direct push stream (SSE): never compressed or buffered, so heartbeats and
	# alerts reach the phone immediately. See docs/push.md.
	@pushstream path /push/stream
	handle @pushstream {
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	handle {
		encode gzip
		reverse_proxy api:8080
	}
}

{$PUSH_ADDRESS} {
	import security_headers
	encode gzip
	reverse_proxy ntfy:80
}
