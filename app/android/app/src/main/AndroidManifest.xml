<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internet access for the API and WebSocket stream. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Fingerprint / face authentication for the optional app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Location for the place picker, welcome hero, and background tracking. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- "Always Allow" background tracking (requested during onboarding). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Motion & fitness (activity recognition) — only on devices with Play Services. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- Background location service (foreground service + wake lock + boot restart). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 14+ (API 34+): required to start a location foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Android 13+ (API 33+): required to show the foreground-service notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Lets the app propose it be exempted from battery optimization so Doze /
         OEM managers don't kill the background location service. Required for
         the ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS deep link. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Android 11+ package visibility: let the emergency-contact picker
         resolve the system ACTION_PICK for a phone number. No READ_CONTACTS. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PICK"/>
            <data android:mimeType="vnd.android.cursor.dir/phone_v2"/>
        </intent>
    </queries>

    <application
        android:label="OpenFamily"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <!-- background_locator_2: restarts tracking after a device reboot. -->
        <receiver
            android:name="yukams.app.background_locator_2.BootBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>
        <!-- background_locator_2: foreground service hosting the background isolate. -->
        <service
            android:name="yukams.app.background_locator_2.IsolateHolderService"
            android:permission="android.permission.FOREGROUND_SERVICE"
            android:exported="false"
            android:foregroundServiceType="location"/>
    </application>
</manifest>
