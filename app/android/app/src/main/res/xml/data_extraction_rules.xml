<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): exclude all app data from cloud backup and from
     device-to-device transfer. The app holds location history, tokens and the
     secure-storage keys, none of which may leave the device (MOB-012). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
