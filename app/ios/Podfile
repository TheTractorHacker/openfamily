# CocoaPods integration for the OpenFamily iOS app.
#
# This file was previously missing from the project, which meant the Flutter
# plugins' iOS implementations (geolocator, permission_handler,
# background_locator_2, flutter_local_notifications, ...) were never linked
# into the Runner target: `pod install`/`flutter build ios` failed at the
# GeneratedPluginRegistrant stage.
#
# The pin must stay in sync with `IPHONEOS_DEPLOYMENT_TARGET` in
# Runner.xcodeproj (15.0) and the minimums required by the plugins.

# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Plugins declare older minimums than the app (app = 15.0); pods must not
    # drag the effective deployment target below the app's.
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end

      # permission_handler compiles each permission out unless its macro is 1,
      # and then EVERY request for it silently returns "denied". Enable only
      # what the app uses (App Review also rejects unused permission code):
      # location (when-in-use + always) and notifications. Camera and photos go
      # through image_picker's own native prompts, contacts through the system
      # picker. Motion/Core Motion is not requested on iOS (driving detection
      # is Android only), so PERMISSION_SENSORS stays 0.
      defs = Array(config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)'])
      defs += ['PERMISSION_LOCATION=1', 'PERMISSION_NOTIFICATIONS=1']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs.uniq
    end
  end
end