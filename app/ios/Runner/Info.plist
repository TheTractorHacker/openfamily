<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Orbitly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Orbitly</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Export compliance: the app uses encryption beyond Apple's operating system
	     (end-to-end encryption for Private circles with the Dart 'cryptography'
	     package, standard algorithms). That is NOT automatically exempt, so we
	     declare it honestly: true. App Store Connect then asks for the export
	     compliance answers once per build (see docs/release/APP_STORE.md,
	     "Export compliance"). Owner/legal: confirm, and if the conclusion is that
	     nothing here is non-exempt, change this to false. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Location permissions (used by the background-location phase). -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Orbitly shares your location with the people in your circles, also while the app is closed, so they can see where you are and get arrival alerts and your SOS position. Only the members of your circles see it, and you can pause or stop sharing at any time in Orbitly.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Orbitly uses your location to show you on the map and, when you turn sharing on, to tell the people in your circles where you are.</string>
	<!-- Motion & fitness (Core Motion) — requested only on supported devices. -->
	<key>NSMotionUsageDescription</key>
	<string>Orbitly uses motion &amp; fitness to detect when you're driving, biking, or walking.</string>
	<!-- Chat photo attachments can use the camera (image_picker ImageSource.camera). -->
	<key>NSCameraUsageDescription</key>
	<string>Orbitly uses the camera to take a photo to send in circle chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Orbitly lets you choose a profile photo, or a photo to send in your circle chat, from your photo library.</string>
	<!-- Face ID is used only when the user enables biometric app unlock. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Orbitly uses Face ID to unlock your private location map.</string>
	<!-- Invite links open the app. https://<server>/join/<code> needs the
	     Associated Domains entitlement (see docs/design/IOS_RELEASE.md);
	     openfamily://join?server=...&code=... works without any entitlement. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.openfamily.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openfamily</string>
			</array>
		</dict>
	</array>
	<!-- The app routes invite links itself (LinkBridge.swift -> DeepLinkService);
	     stop Flutter from also pushing the URL path onto the Navigator. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<!-- Handoff from the Apple Watch app (OrbitlyWatch/PersonViews.swift). -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>app.openfamily.watch.person</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
