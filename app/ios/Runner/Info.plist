<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Orbitly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Orbitly</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Location permissions (used by the background-location phase). -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Orbitly tracks your location in the background so the people in your circles can see where you are.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Orbitly uses your location to show your position on the map.</string>
	<!-- Motion & fitness (Core Motion) — requested only on supported devices. -->
	<key>NSMotionUsageDescription</key>
	<string>Orbitly uses motion &amp; fitness to detect when you're driving, biking, or walking.</string>
	<!-- Chat photo attachments can use the camera (image_picker ImageSource.camera). -->
	<key>NSCameraUsageDescription</key>
	<string>Orbitly uses the camera to take a photo to send in circle chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Orbitly lets you choose a profile photo from your photo library.</string>
	<!-- Face ID is used only when the user enables biometric app unlock. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Orbitly uses Face ID to unlock your private location map.</string>
	<!-- Invite links open the app. https://<server>/join/<code> needs the
	     Associated Domains entitlement (see docs/design/IOS_RELEASE.md);
	     openfamily://join?server=...&code=... works without any entitlement. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.openfamily.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>openfamily</string>
			</array>
		</dict>
	</array>
	<!-- The app routes invite links itself (LinkBridge.swift -> DeepLinkService);
	     stop Flutter from also pushing the URL path onto the Navigator. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
