# OpenFamily configuration. ./scripts/setup.sh generates this file for you
# (with random secrets). To do it by hand: cp .env.example .env and fill in
# the required values. Compose refuses to start without POSTGRES_PASSWORD and
# JWT_SECRET.

# --- Required ---
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Generate with: openssl rand -hex 32  (at least 32 characters)
JWT_SECRET=

# --- Common ---
# Public address. ":80" = plain HTTP (local/trusted network). A domain such as
# openfamily.example.com makes the Caddy "proxy" profile request a certificate.
SITE_ADDRESS=:80
# Optional compose profiles: proxy (Caddy HTTPS), push (ntfy). Comma separated.
COMPOSE_PROFILES=
# "development" (default) or "production". Production fails fast on insecure
# settings, including Postgres sslmode (see DB_SSL_DISABLE_OK below).
APP_ENV=development
# First platform admin. Setting the email also CLOSES open registration (invite
# codes required). The account is auto-created with the password on first start.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ============================== Advanced ==============================

# --- Database ---
# POSTGRES_USER / POSTGRES_DB: keep the values of an existing deployment.
POSTGRES_USER=openfamily
POSTGRES_DB=openfamily
# sslmode used in the DATABASE_URL compose builds. The bundled Postgres has no
# TLS, so it stays "disable" and APP_ENV=production additionally needs
# DB_SSL_DISABLE_OK=true (safe only because Postgres is reachable solely on the
# private Docker network). For an external Postgres set DATABASE_URL below with
# sslmode=require or verify-full and leave DB_SSL_DISABLE_OK unset.
DB_SSLMODE=disable
DB_SSL_DISABLE_OK=false
# DATABASE_URL=postgres://user:pass@db.example.com:5432/openfamily?sslmode=verify-full

# --- Networking ---
# Host port for the API (published on 127.0.0.1 only).
API_PORT=8080
# Bind address for the API port. 127.0.0.1 (default) is local only; use 0.0.0.0 or a LAN IP when an external reverse proxy forwards to this host.
API_BIND=127.0.0.1
TRUSTED_PROXIES=
# CORS origin for the API (empty = same-origin only).
ALLOWED_ORIGIN=
# The API runs behind a TLS-terminating proxy (Caddy or your own).
TLS_BEHIND_PROXY=true
# Explicit opt-out of TLS (trusted private networks only).
INSECURE_HTTP=false
# Caddyfile in ./caddy to use. Use Caddyfile.with-push with profiles proxy,push.
# CADDYFILE=Caddyfile.with-push

# --- Push (profile "push": self-hosted ntfy) ---
PUSH_ADDRESS=
# Public base URL for ntfy (https:// in production). Served on GET /config.
NTFY_BASE_URL=http://localhost:2586
# Include the tracked user's name in push payloads (default omits it).
VERBOSE_PUSH=false
# APNs (iOS push). Empty disables. Mount the .p8 key (see docker-compose.yml).
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=false

# --- Map tiles (empty = OSM street + Esri satellite) ---
# A key in the URL is visible to every phone.
TILE_URL=
SATELLITE_TILE_URL=

# --- Optional Twilio SMS for Check In / Help / SOS (empty = in-app only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public https origin for SMS share links, e.g. https://openfamily.example.com
PUBLIC_BASE_URL=

# --- Android APK download in the admin panel ---
APK_DIR=/data/apk
APK_GITHUB_REPO=wheresfrank/openfamily
# Only needed to fetch from a private fork. Never commit this value.
APK_GITHUB_TOKEN=
